<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <Target Name="ExtractGuiContracts" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate.py&quot; &quot;$(IntermediateOutputPath)GuiContracts.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)GuiContracts.cs" /></ItemGroup>
  </Target>
</Project>
