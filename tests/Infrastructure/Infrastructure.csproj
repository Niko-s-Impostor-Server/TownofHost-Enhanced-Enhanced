<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Modules/OptionItem/*.cs" Link="Production/OptionItem/%(Filename)%(Extension)" />
    <Compile Include="../../Modules/OptionSaver.cs" Link="Production/OptionSaver.cs" />
    <Compile Include="../../Modules/LateTask.cs" Link="Production/LateTask.cs" />
    <Compile Include="../../Modules/OptionBackup/*.cs" Link="Production/OptionBackup/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ExtractNativeBoolContracts" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/extract_native_options.py&quot; &quot;$(IntermediateOutputPath)NativeBoolContracts.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)NativeBoolContracts.cs" /></ItemGroup>
  </Target>
</Project>
