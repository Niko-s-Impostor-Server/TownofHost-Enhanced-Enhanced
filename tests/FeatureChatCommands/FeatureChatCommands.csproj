<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Modules/FeatureChatCommands.cs" Link="Production/FeatureChatCommands.cs" />
    <Compile Include="../../Modules/LocalPlayerTags*.cs" Link="Production/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ExtractLegacyModeratorGuards" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate.py&quot; &quot;$(IntermediateOutputPath)GeneratedLegacyGuards.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)GeneratedLegacyGuards.cs" /></ItemGroup>
  </Target>
</Project>
