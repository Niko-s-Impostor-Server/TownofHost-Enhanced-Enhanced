<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Modules/CustomRpcReceiver.cs" Link="Production/CustomRpcReceiver.cs" />
    <Compile Include="../../Modules/Rpc/RpcPayloadSnapshot.cs" Link="Production/RpcPayloadSnapshot.cs" />
  </ItemGroup>
  <Target Name="ExtractRpcEntry" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate.py&quot; &quot;$(IntermediateOutputPath)GeneratedRpcEntry.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)GeneratedRpcEntry.cs" /></ItemGroup>
  </Target>
</Project>
