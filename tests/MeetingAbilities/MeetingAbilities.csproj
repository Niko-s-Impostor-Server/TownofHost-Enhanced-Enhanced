<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Modules/MeetingAbilities.cs" Link="Production/MeetingAbilities.cs" />
    <Compile Include="../../Modules/RpcCompatibility.cs" Link="Production/RpcCompatibility.cs" />
    <Compile Include="../../Modules/MeetingAbilityReplayWindow.cs" Link="Production/MeetingAbilityReplayWindow.cs" />
    <Compile Include="../../Patches/MeetingAbilityPatch.cs" Link="Production/MeetingAbilityPatch.cs" />
  </ItemGroup>
  <Target Name="ExtractVotePrefix" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate.py&quot; &quot;$(IntermediateOutputPath)GeneratedVote.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)GeneratedVote.cs" /></ItemGroup>
  </Target>
</Project>
