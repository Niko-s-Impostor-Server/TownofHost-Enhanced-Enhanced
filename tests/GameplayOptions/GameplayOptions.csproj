<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <Target Name="ExtractGameplayOptions" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate.py&quot; &quot;$(IntermediateOutputPath)GameplayOptions.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)GameplayOptions.cs" /></ItemGroup>
  </Target>
</Project>
