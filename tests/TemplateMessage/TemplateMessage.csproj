<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../Resources/Config/template/SChinese.txt" Link="SChinese.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExtractTemplateParser" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/extract.py&quot; &quot;$(IntermediateOutputPath)TemplateParser.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)TemplateParser.cs" /></ItemGroup>
  </Target>
</Project>
