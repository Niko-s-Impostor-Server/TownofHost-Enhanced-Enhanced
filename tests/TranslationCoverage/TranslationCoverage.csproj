<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NativeSource Condition="'$(TOHE_NATIVE_SOURCE)' != ''">$(TOHE_NATIVE_SOURCE)</NativeSource>
    <NativeSource Condition="'$(NativeSource)' == ''">D:/SharedUserFiles/TestDesktop/opencode-chat/assembly-compare/src-2026.8.18</NativeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(NativeSource)/SupportedLangs.cs" Link="SupportedLangs.cs" />
    <Compile Include="$(NativeSource)/StringNames.cs" Link="StringNames.cs" />
    <EmbeddedResource Include="../../Resources/Lang/*.json" WithCulture="false" LogicalName="TOHE.Resources.Lang.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ExtractTranslatorMethods" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate.py&quot; &quot;$(IntermediateOutputPath)GeneratedTranslator.cs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GeneratedTranslator.cs" />
    </ItemGroup>
  </Target>
</Project>
