<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <Description>Town Of Host Enhanced Enhanced</Description>
    <Authors>Moe; TOHEE contributors</Authors>
    <LangVersion>12.0</LangVersion>
    <Configurations>Debug;Release;Canary</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <CodePage>65001</CodePage>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <!-- Translator reads every language from the main assembly, including dotted Features locale files. -->
    <EmbeddedResource Include="Resources/**" WithCulture="false" />
  </ItemGroup>
  <!-- Use the interop assemblies generated for the actual IL2CPP installation. -->
  <ItemGroup Condition="'$(LocalAmongUsPath)' != ''">
    <Reference Include="$(LocalAmongUsPath)/BepInEx/interop/*.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/MonoMod.Utils.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/Mono.Cecil.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(LocalAmongUsPath)' == ''">
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.8.18" PrivateAssets="all" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GitInfo" Version="3.3.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ValidateLocalGame" BeforeTargets="ResolveReferences" Condition="'$(LocalAmongUsPath)' != ''">
    <Error Condition="!Exists('$(LocalAmongUsPath)/BepInEx/interop/Assembly-CSharp.dll')" Text="LocalAmongUsPath must point to an Among Us 2026.8.18 installation with generated BepInEx interop assemblies." />
    <Error Condition="!Exists('$(LocalAmongUsPath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll')" Text="BepInEx IL2CPP is missing from LocalAmongUsPath." />
  </Target>
  <Target Name="CopyPlugin" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" />
  </Target>
</Project>
